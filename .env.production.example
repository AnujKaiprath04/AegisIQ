# ==============================================================================
# AegisIQ: Enterprise Decision Intelligence Platform — Production Environment Matrix
# ==============================================================================

# Core System
ENVIRONMENT=production
PROJECT_NAME="AegisIQ Enterprise Platform"
API_V1_STR=/api/v1
SECRET_KEY=generate-a-cryptographically-secure-256-bit-key-here-do-not-share
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL 16 High-Availability Cluster)
POSTGRES_SERVER=aegisiq-db
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-with-secure-database-password
POSTGRES_DB=aegisiq_db
DATABASE_URL=postgresql://aegis:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# In-Memory Cache & Message Broker (Redis 7)
REDIS_HOST=aegisiq-redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# CORS Allowed Origins (JSON Array of strings)
BACKEND_CORS_ORIGINS=["https://aegisiq.enterprise.internal", "https://app.aegisiq.com"]

# LLM & AI Service API Keys (OpenAI / Google Gemini / Ollama)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here

# Security & Compliance
AUDIT_LOG_RETENTION_DAYS=365
ENABLE_ZERO_TRUST_ENFORCEMENT=true
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Multi-Channel Alerting & Webhooks
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXX
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-or-ses-smtp-token
EMAILS_FROM_EMAIL=security-alerts@aegisiq.com
EMAILS_FROM_NAME="AegisIQ Security & Intelligence"
