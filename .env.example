# ==============================================================================
# AegisIQ: Enterprise Decision Intelligence Platform — Environment Template
# ==============================================================================

# Core System
ENVIRONMENT=development
PROJECT_NAME="AegisIQ: Enterprise Decision Intelligence Platform"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-cryptographically-secure-256-bit-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL or local SQLite for development)
# Local Dev Default:
DATABASE_URL=sqlite:///./aegisiq.db
# Production Neon/PostgreSQL Cluster:
# DATABASE_URL=postgresql://user:password@host:5432/aegisiq_db

# In-Memory Cache & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (JSON Array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# LLM Gateway API Keys (Optional: populate for live AI Copilot responses)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Security & Observability
AUDIT_LOG_RETENTION_DAYS=365
ENABLE_ZERO_TRUST_ENFORCEMENT=true
