{
  "info": {
    "name": "AegisIQ Enterprise Platform REST API Collection",
    "_postman_id": "aegisiq-api-v1-collection",
    "description": "Comprehensive Postman & Newman test collection covering all 39 platform endpoints across Parts 1, 2, 3, and 4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login & Obtain Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@aegisiq.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Multi-Domain BI & KPIs",
      "item": [
        {
          "name": "Get KPI Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/bi/kpis/summary", "host": ["{{base_url}}"], "path": ["api", "v1", "bi", "kpis", "summary"] }
          }
        }
      ]
    },
    {
      "name": "3. Generative AI & Copilot",
      "item": [
        {
          "name": "AI Assistant Query",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Analyze enterprise retention risks\",\n  \"top_k\": 3\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/rag/query", "host": ["{{base_url}}"], "path": ["api", "v1", "rag", "query"] }
          }
        }
      ]
    },
    {
      "name": "4. Machine Learning & XAI",
      "item": [
        {
          "name": "Predict Customer Churn",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"ACC-001\",\n  \"company_name\": \"Apex Logistics\",\n  \"license_utilization_pct\": 34.0,\n  \"support_tickets_last_30d\": 12,\n  \"nps_score\": 4,\n  \"days_to_renewal\": 45\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/ml/predictions/churn", "host": ["{{base_url}}"], "path": ["api", "v1", "ml", "predictions", "churn"] }
          }
        }
      ]
    }
  ]
}
